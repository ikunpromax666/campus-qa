<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.campus</groupId>
        <artifactId>campus-qa</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>campus-qa-web</artifactId>
    <dependencies>
        <!-- SpringDoc OpenAPI（Swagger 现代替代品，Boot 3/4 原生支持） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.8</version>
        </dependency>

        <!-- 密码加密 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- MyBatis-Plus Starter：提供 SqlSessionFactory 自动配置（必须加在 web 模块） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MyBatis-Plus 扩展模块：提供 MybatisPlusInterceptor 等基础拦截器框架 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <!-- MyBatis-Plus 3.5.9+ 分页/多租户等插件拆分到此模块，需显式引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!--web 依赖 service，service 依赖 mapper，mapper 依赖 pojo——但 common 不在传递链里
         web 模块要用 JwtUtils、Result、BusinessException 等 common 的类，必须显式依赖 common 模块 -->
        <dependency>
            <groupId>com.campus</groupId>
            <artifactId>campus-qa-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 依赖 service 层，mapper/pojo/common 会随之传递下来 -->
        <dependency>
            <groupId>com.campus</groupId>
            <artifactId>campus-qa-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
      <!--`spring-boot-starter-web` 会自动引入 spring-webmvc、spring-web、Tomcat、Jackson。-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>
</project>
